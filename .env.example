# Copy to .env and fill in. API and worker read the same file.

# Redis password (docker-compose reads it via --env-file); keep it in REDIS_URL too
REDIS_PASSWORD=change-me
REDIS_URL=redis://:change-me@127.0.0.1:6379/0

# r2 = Cloudflare R2 (production) | local = files under data/storage served by this API (testing)
STORAGE_BACKEND=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=upscale

# Public URL of this API (used for local-backend links)
PUBLIC_BASE_URL=https://upscale.qhuy204.id.vn
# Random string; signs local-backend links. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SIGNING_SECRET=change-me

# Capacity (i5-13400F + RTX 3060): benchmark peak ~690 ads/h; NVENC saturates at ~6-8 sessions, >10 falls back to x264
FFMPEG_SLOTS=8
THREADS_PER_JOB=3
WORKER_MAX_JOBS=24
# auto = tự nhận card: NVIDIA (nvenc) > AMD (amf) > Intel (qsv) > CPU (x264); hoặc ghi cố định
ENCODER=auto
# Máy AMD Radeon RX 6600 (VCN 3.0): đổi 3 dòng trên thành
#   ENCODER=amf          # bỏ qua bước dò NVIDIA
#   FFMPEG_SLOTS=6       # VCN 3.0 chậm hơn NVENC 3060 một chút; tăng dần nếu bench còn dư
#   THREADS_PER_JOB=<số luồng CPU / 6>, WORKER_MAX_JOBS=18
# rồi chạy scripts\bench.ps1 để chỉnh. Cần driver Adrenalin mới (có amfrt64.dll).

# Limits
JOB_TIMEOUT=600
MAX_RETRIES=2
MAX_INPUT_MB=300
MAX_UPLOAD_MB=95
MAX_DURATION=600
MAX_SIDE=4096
MAX_BATCH=100
OUTPUT_URL_TTL=86400
JOB_TTL=604800

# Defaults per API key (override per key with tools/manage_keys.py limits)
DEFAULT_MAX_QUEUED=200
DEFAULT_MAX_RUNNING=8

# Dashboard (docker compose service "dashboard", http://127.0.0.1:8090). Empty password = disabled.
ADMIN_USER=admin
ADMIN_PASSWORD=
